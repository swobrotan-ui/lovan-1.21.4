<Window x:Class="LovanLauncher.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:local="clr-namespace:LovanLauncher"
         Title="Lovan Launcher" Width="950" Height="550"
         WindowStyle="None" AllowsTransparency="True" Background="Transparent"
         WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <local:StringEmptyToVisibilityConverter x:Key="EmptyToVisConverter"/>
        
        <Storyboard x:Key="LogoGlitchStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LogoText"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.1" AutoReverse="True"/>
            <ColorAnimation Storyboard.TargetName="LogoText"
                            Storyboard.TargetProperty="Foreground"
                            From="#FF0055" To="#120224" Duration="0:0:1.5"
                            RepeatBehavior="Forever" AutoReverse="True"/>
        </Storyboard>
        
        <Storyboard x:Key="UsernameFocusStoryboard">
            <ThicknessAnimation Storyboard.TargetName="UsernameBorder"
                                Storyboard.TargetProperty="Padding"
                                From="10,0,10,0" To="15,0,5,0" Duration="0:0:0.2"/>
        </Storyboard>
        
        <Storyboard x:Key="ButtonHoverStoryboard">
            <DoubleAnimation Storyboard.TargetName="PlayButton"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.06" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="PlayButton"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.06" Duration="0:0:0.15"/>
            <ColorAnimation Storyboard.TargetName="PlayButton"
                            Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                            To="#FF0055" Duration="0:0:0.15"/>
            <ColorAnimation Storyboard.TargetName="PlayButton"
                            Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                            To="#120224" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="PlayButtonGlow"
                             Storyboard.TargetProperty="BlurRadius"
                             From="10" To="35" Duration="0:0:0.15"/>
        </Storyboard>
        
        <Storyboard x:Key="ButtonLeaveStoryboard">
            <DoubleAnimation Storyboard.TargetName="PlayButton"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="PlayButton"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1" Duration="0:0:0.15"/>
            <ColorAnimation Storyboard.TargetName="PlayButton"
                            Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                            To="#2D0F4D" Duration="0:0:0.15"/>
            <ColorAnimation Storyboard.TargetName="PlayButton"
                            Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                            To="#1A0A0C" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="PlayButtonGlow"
                             Storyboard.TargetProperty="BlurRadius"
                             From="35" To="10" Duration="0:0:0.15"/>
        </Storyboard>
        
        <DropShadowEffect x:Key="NeonGlow" Color="#00FF66" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
        <BlurEffect x:Key="HeavyBlur" Radius="25"/>
        
        <RadialGradientBrush x:Key="PulseBrush" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Color="#FF0055" Offset="0"/>
            <GradientStop Color="#120224" Offset="0.6"/>
            <GradientStop Color="#000000" Offset="1"/>
        </RadialGradientBrush>
    </Window.Resources>

    <Border CornerRadius="20" MouseLeftButtonDown="Window_DragMove">
        <Border.Effect>
            <BlurEffect Radius="25"/>
        </Border.Effect>
        <Border.Background>
            <SolidColorBrush Color="#050507"/>
        </Border.Background>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" HorizontalAlignment="Center" Width="600" Height="200" CornerRadius="16"
                    Background="{StaticResource PulseBrush}" Effect="{StaticResource NeonGlow}">
                <TextBlock x:Name="LogoText"
                           Text="LOVAN CLIENT"
                           FontSize="72"
                           FontWeight="Bold"
                           FontFamily="Consolas, monospace"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FF0055">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource LogoGlitchStoryboard}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Border>

            <Border Grid.Row="1"
                    Width="380"
                    Height="55"
                    Margin="0,20"
                    CornerRadius="12"
                    Background="Transparent"
                    BorderBrush="#5A2A83"
                    BorderThickness="1.5">
                <Border x:Name="UsernameBorder" Padding="10,0">
                    <Grid>
                        <TextBox x:Name="UsernameBox"
                                 TextAlignment="Center"
                                 FontSize="18"
                                 FontFamily="Consolas, monospace"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="5,0"
                                 GotFocus="UsernameBox_GotFocus"
                                 LostFocus="UsernameBox_LostFocus"
                                 VerticalScrollBarVisibility="Disabled"/>
                        <TextBlock Text="Enter Username..."
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="10,0"
                                   Foreground="#777777"
                                   FontSize="18"
                                   FontFamily="Consolas, monospace"
                                   Visibility="{Binding ElementName=UsernameBox, Path=Text, Converter={StaticResource EmptyToVisConverter}}"/>
                    </Grid>
                </Border>
            </Border>

            <Button x:Name="PlayButton"
                    Grid.Row="2"
                    Content="ЗАПУСТИТЬ СИСТЕМУ"
                    Width="320"
                    Height="70"
                    FontSize="20"
                    FontWeight="Bold"
                    FontFamily="Consolas, monospace"
                    HorizontalAlignment="Center"
                    Margin="0,40"
                    Click="PlayButton_Click"
                    RenderTransformOrigin="0.5,0.5"
                    Effect="{StaticResource NeonGlow}">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2D0F4D" Offset="0"/>
                        <GradientStop Color="#1A0A0C" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="PlayButtonGlow" BlurRadius="10" Color="#00FF66" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard Storyboard="{StaticResource ButtonHoverStoryboard}"/>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard Storyboard="{StaticResource ButtonLeaveStoryboard}"/>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Border>
</Window>